# Copy to .env and fill in. Placeholders only: never put a real key in this file.

# Anthropic (used from the Sat-midday step onward)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-opus-5-5
# Thinking depth / cost dial: low | medium | high (default medium)
ANTHROPIC_EFFORT=medium

# Path to the SQLite memory database (defaults to couples_agent.db)
COUPLES_AGENT_DB=couples_agent.db

# Optional LangSmith tracing. Leave unset to run fully offline.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key-here
# LANGSMITH_PROJECT=couples-agent
# For real (non-synthetic) sessions, hide content from traces:
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true
